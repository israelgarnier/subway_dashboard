# Token de API de Apify (Settings -> API & Integrations en console.apify.com)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Actor que corre el scraper (por defecto andok/google-news-scraper).
# Nota: en la API de Apify el "/" se escribe como "~".
APIFY_ACTOR=andok~google-news-scraper

# Opcional: si en vez del actor agendas un Task con nombre/id, ponlo aquí
# y el dashboard leerá la última corrida de ese task.
# APIFY_TASK=
